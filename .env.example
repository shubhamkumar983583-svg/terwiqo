# Environment Variables Template
# Copy this file to .env and configure local variables as needed.
# Placeholders only - DO NOT commit real secrets here.

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# DATABASE_URL: PostgreSQL connection string (Cloud SQL or standard PostgreSQL).
# Format: postgresql://username:password@host:port/database_name?sslmode=prefer
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/workpulse_db"

# JWT_SECRET: Cryptographically strong secret key for signing session tokens (min 32 chars).
JWT_SECRET="replace-with-a-secure-256-bit-random-secret-key"

# COOKIE_SECRET: Secret for signing session cookies.
COOKIE_SECRET="replace-with-secure-cookie-secret"

# PORT: Server listening port (default: 3000)
PORT="3000"

# SUPABASE_PROJECT_ID: Optional Supabase project identifier
SUPABASE_PROJECT_ID="your-project-id"

# SUPABASE_URL: Supabase API URL endpoint
SUPABASE_URL="https://your-project.supabase.co"

# SUPABASE_ANON_KEY: Supabase publishable/anon API key
SUPABASE_ANON_KEY="your-supabase-anon-key"
